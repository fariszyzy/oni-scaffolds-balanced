<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Scaffolds</AssemblyName>
    <RootNamespace>Scaffolds</RootNamespace>
    <ONIPath Condition="'$(ONIPath)' == ''">D:\SteamLibrary\steamapps\common\OxygenNotIncluded</ONIPath>
    <ONIManaged>$(ONIPath)\OxygenNotIncluded_Data\Managed</ONIManaged>
    <!-- The mod folder itself is the install location: the game loads Scaffolds.dll from here -->
    <ModDeployDir>$(MSBuildProjectDirectory)</ModDeployDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PLib" Version="4.17.1" />
    <PackageReference Include="ILRepack" Version="2.0.18" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(ONIManaged)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ONIManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ONIManaged)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ONIManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ONIManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ONIManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <!-- Merge PLib into Scaffolds.dll and drop the result in the mod folder root -->
  <Target Name="MergeAndDeploy" AfterTargets="Build">
    <Exec Command="&quot;$(PkgILRepack)\tools\ILRepack.exe&quot; /ndebug /lib:&quot;$(ONIManaged)&quot; /out:&quot;$(ModDeployDir)\Scaffolds.dll&quot; &quot;$(TargetPath)&quot; &quot;$(OutDir)PLib.dll&quot;" />
  </Target>

</Project>
